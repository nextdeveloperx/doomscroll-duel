rules_version = '2';

// Doomscroll Duel security rules.
//
// Principles
//  - Friendships, usernames, invites and duel setup are written only by Cloud Functions (admin SDK),
//    never by clients, so nobody can forge a friend or a duel.
//  - A player's reel count is readable by the other player ONLY while their duel is 'active'.
//    Before it starts, after it ends, or for anyone who is not a player, the read is denied.
//  - Clients upload aggregates (a total and a per-app total for today). No content, no event times.
//  - Coins are virtual and written only by functions; the app has no write access to them.
//
// NOT YET RUN against the Firestore emulator (it could not be downloaded when these were written).
// Run `firebase emulators:exec` with @firebase/rules-unit-testing before shipping.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function areFriends(uid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(uid));
    }

    // Wallet helpers, used by both the wallet rules and the leaderboard fields on `directory`.

    function duelCount(duelId, uid) {
      let p = /databases/$(database)/documents/duels/$(duelId)/counts/$(uid);
      return exists(p) ? get(p).data.total : 0;
    }

    // The lower reel count wins (see DuelSettlement.settle). Forfeits are not recognised here: the tracking gaps
    // that decide a forfeit are never written to Firestore, so a forfeited duel settles as a tie under these rules
    // (both stakes refunded) until a Cloud Function can see the real gaps and pay the forfeit winner instead.
    function duelWinner(duelId) {
      let d = duel_(duelId);
      let a = duelCount(duelId, d.players[0]);
      let b = duelCount(duelId, d.players[1]);
      return a < b ? d.players[0] : (b < a ? d.players[1] : null);
    }

    function duel_(duelId) {
      return get(/databases/$(database)/documents/duels/$(duelId)).data;
    }

    // Username -> uid lookup, so friends can be added by username.
    // `get` only: usernames cannot be listed or enumerated.
    //
    // Claiming. The Cloud Function `completeProfile` does it with the admin SDK. While that function is not deployed the app
    // does the same thing itself, so the rule below allows exactly what the function would write and nothing more:
    //  - create only (a name that exists can never be taken over, changed or deleted by a client),
    //  - the document says who owns it and that must be the signed-in person,
    //  - the name must be a valid username, and the same batch must create that person's profile with that very name,
    //    so one person ends up with one username.
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z][a-z0-9_.]{2,19}$')
        && !name.matches('.*(__|[.][.]|_[.]|[.]_).*')
        && !name.matches('.*[_.]$')
        && !(name in ['admin', 'support', 'help', 'doomscroll', 'duel', 'official', 'moderator', 'system'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow list, update, delete: if false;
    }

    // Profile: the owner and that person's friends can read it. The owner may edit display fields only.
    // The first write of the profile (username, display name, colour) may come from the app together with the username
    // claim above; server-owned fields such as the email hash can only be written by functions.
    match /users/{uid} {
      allow read: if isSelf(uid) || areFriends(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'avatarColor', 'createdAt'])
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.avatarColor == 'pink'
        && request.resource.data.createdAt == request.time;
      allow delete: if false;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarColor'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30;

      // Friend edges. The Cloud Functions (acceptInvite / addFriendByUsername) write both sides with the admin SDK. While the
      // functions are not deployed, the person who ACCEPTS an invite may write the two edges themselves, and only when an
      // invite from that very person is waiting in their own inbox. Two cases, one condition:
      //   users/{me}/friends/{inviter}   written by me          (my side)
      //   users/{inviter}/friends/{me}   written by me as friendUid (the inviter's side)
      // Both edges describe `friendUid` and must match that person's public directory entry, so nobody can invent a name.
      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        allow create: if signedIn()
          && uid != friendUid
          && ((isSelf(uid) && exists(/databases/$(database)/documents/users/$(uid)/inbox/$(friendUid)))
              || (request.auth.uid == friendUid && exists(/databases/$(database)/documents/users/$(friendUid)/inbox/$(uid))))
          && request.resource.data.keys().hasOnly(['uid', 'username', 'displayName', 'since'])
          && request.resource.data.uid == friendUid
          && request.resource.data.username == get(/databases/$(database)/documents/directory/$(friendUid)).data.username
          && request.resource.data.displayName == get(/databases/$(database)/documents/directory/$(friendUid)).data.displayName
          && request.resource.data.since == request.time;
        allow update, delete: if false;
      }

      // Invites waiting for me. Anyone signed in may leave ONE invite per person (the document id is the sender's uid, so a
      // second one is an overwrite, which is refused). Only I can read, accept or decline mine.
      match /inbox/{fromUid} {
        allow read, delete: if isSelf(uid);
        allow create: if signedIn()
          && request.auth.uid == fromUid
          && uid != fromUid
          && request.resource.data.keys().hasOnly(['fromUid', 'fromUsername', 'fromName', 'createdAt'])
          && request.resource.data.fromUid == fromUid
          && request.resource.data.fromUsername == get(/databases/$(database)/documents/directory/$(fromUid)).data.username
          && request.resource.data.fromName == get(/databases/$(database)/documents/directory/$(fromUid)).data.displayName
          && request.resource.data.createdAt == request.time
          && !exists(/databases/$(database)/documents/users/$(uid)/friends/$(fromUid));
        allow update: if false;
      }

      // "Come to my broadcast": one per sender (the document id is the sender's uid). The sender must be in that room right now, the
      // room and title are checked against the room itself, and a sender can send again only after 30 seconds. Only I read or clear mine.
      match /broadcastInvites/{fromUid} {
        allow read, delete: if isSelf(uid);
        allow create: if signedIn()
          && request.auth.uid == fromUid
          && uid != fromUid
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'roomId', 'title', 'createdAt'])
          && request.resource.data.fromUid == fromUid
          && request.resource.data.fromName == get(/databases/$(database)/documents/directory/$(fromUid)).data.displayName
          && request.resource.data.roomId is string
          && exists(/databases/$(database)/documents/broadcasts/$(request.resource.data.roomId)/members/$(fromUid))
          && request.resource.data.title == get(/databases/$(database)/documents/broadcasts/$(request.resource.data.roomId)).data.title
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn()
          && request.auth.uid == fromUid
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'roomId', 'title', 'createdAt'])
          && request.resource.data.fromUid == fromUid
          && request.resource.data.fromName == get(/databases/$(database)/documents/directory/$(fromUid)).data.displayName
          && exists(/databases/$(database)/documents/broadcasts/$(request.resource.data.roomId)/members/$(fromUid))
          && request.resource.data.title == get(/databases/$(database)/documents/broadcasts/$(request.resource.data.roomId)).data.title
          && request.time > resource.data.createdAt + duration.value(30, 's')
          && request.resource.data.createdAt == request.time;
      }

      // Who I have invited (so the button can say "BHEJA"). Mine alone.
      match /sentInvites/{targetUid} {
        allow read, write: if isSelf(uid);
      }
    }

    // The public directory: every signed-in person's username and display name, nothing else (no email, no hash, no counts).
    // This is what the People list shows. Created together with the profile, so one person has exactly one entry that always
    // matches the claimed username; the owner may only change the display name.
    match /directory/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'createdAt'])
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid) && (
          // display name
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 30)
          // Public profile: a short bio and four social handles (plain handles, never links; the app builds the link), all optional,
          // each a short string. The person's own phone writes them; nothing else in the document may change in the same write.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio', 'instagram', 'youtube', 'snapchat', 'facebook'])
            && request.resource.data.get('bio', '') is string && request.resource.data.get('bio', '').size() <= 150
            && request.resource.data.get('instagram', '') is string && request.resource.data.get('instagram', '').size() <= 40
            && request.resource.data.get('youtube', '') is string && request.resource.data.get('youtube', '').size() <= 40
            && request.resource.data.get('snapchat', '') is string && request.resource.data.get('snapchat', '').size() <= 40
            && request.resource.data.get('facebook', '') is string && request.resource.data.get('facebook', '').size() <= 40)
          // Leaderboard score for the two boards (Dost = friends, weekly; India = everyone, monthly). The person's own
          // phone reports it (same trust level as duel reel counts: a modified app could lie about its own score here
          // too, see /duels/{id}/counts). The value must come from that person's own wallet, so it cannot be invented,
          // and a period key change is the only way the number may go DOWN (a fresh period starting at zero).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weeklyCoins', 'weeklyPeriodKey'])
            && request.resource.data.weeklyPeriodKey is string
            && request.resource.data.weeklyCoins is int && request.resource.data.weeklyCoins >= 0
            && (request.resource.data.weeklyPeriodKey != resource.data.get('weeklyPeriodKey', '')
                || request.resource.data.weeklyCoins >= resource.data.get('weeklyCoins', 0)))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['monthlyCoins', 'monthlyPeriodKey'])
            && request.resource.data.monthlyPeriodKey is string
            && request.resource.data.monthlyCoins is int && request.resource.data.monthlyCoins >= 0
            && (request.resource.data.monthlyPeriodKey != resource.data.get('monthlyPeriodKey', '')
                || request.resource.data.monthlyCoins >= resource.data.get('monthlyCoins', 0)))
        );
      allow delete: if false;
    }

    // Broadcast: a voice room between friends. The audio and the chat never touch Firestore: they travel peer to peer (WebRTC),
    // and chat is kept only on each phone. Firestore holds just who is in the room and the short-lived connection messages
    // (offer / answer / network candidate) people exchange to find each other; those are deleted as soon as they are read.
    //  - a room is created by its host and can be joined by ANY signed-in person (the list shows every live room), unless the host
    //    has removed that person: the host's removal writes a `kicked` document, and a kicked person cannot join again;
    //  - a member document is the person's own, and its time is refreshed every few seconds while they are in the room;
    //  - a connection message can be written only by its sender, to somebody who is in the same room, and read or deleted only
    //    by the person it is addressed to.
    match /broadcasts/{room} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['hostUid', 'hostName', 'title', 'createdAt', 'seenAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string && request.resource.data.hostName.size() >= 1 && request.resource.data.hostName.size() <= 30
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 40
        && request.resource.data.createdAt == request.time
        && request.resource.data.seenAt == request.time;
      // A sign of life (host or member), or the host closing the room: `closed` can only be switched on, only by the host, and only
      // that field changes. Everybody in the room sees the mark and leaves.
      allow update: if signedIn()
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
              && request.resource.data.seenAt == request.time
              && (resource.data.hostUid == request.auth.uid
                  || exists(/databases/$(database)/documents/broadcasts/$(room)/members/$(request.auth.uid))))
            || (resource.data.hostUid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed'])
                && request.resource.data.closed == true));
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      function roomData() {
        return get(/databases/$(database)/documents/broadcasts/$(room)).data;
      }

      function inRoom(uid) {
        return exists(/databases/$(database)/documents/broadcasts/$(room)/members/$(uid));
      }

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid)
          && !exists(/databases/$(database)/documents/broadcasts/$(room)/kicked/$(uid))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'username', 'joinedAt', 'seenAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
          && request.resource.data.username is string && request.resource.data.username.size() <= 20
          && request.resource.data.joinedAt == request.time
          && request.resource.data.seenAt == request.time;
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
          && request.resource.data.seenAt == request.time;
        // The person leaves, or the host removes someone.
        allow delete: if isSelf(uid) || roomData().hostUid == request.auth.uid;
      }

      // Removed by the host. Only the host writes it; the removed person and the host can read it.
      match /kicked/{uid} {
        allow read: if signedIn() && (isSelf(uid) || roomData().hostUid == request.auth.uid);
        allow create: if signedIn()
          && roomData().hostUid == request.auth.uid
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /signals/{id} {
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'to', 'type', 'sdp', 'mid', 'index', 'candidate', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to is string
          && request.resource.data.type in ['offer', 'answer', 'ice']
          && inRoom(request.auth.uid) && inRoom(request.resource.data.to)
          && (!('sdp' in request.resource.data) || request.resource.data.sdp.size() <= 30000)
          && (!('candidate' in request.resource.data) || request.resource.data.candidate.size() <= 2000)
          && request.resource.data.createdAt == request.time;
        allow get, list, delete: if signedIn() && resource.data.to == request.auth.uid;
        allow update: if false;
      }
    }

    // Contacts matching without a Cloud Function. A person's own email, hashed (SHA-256, 64 hex characters), points at their uid.
    // The phone looks up the hash of each contact's email ONE DOCUMENT AT A TIME (get), so the index cannot be listed or downloaded.
    // The rules cannot recompute a hash, so a person could register someone else's hash; the worst that does is make a wrong
    // person appear as a match in that contact's list, and the real owner can still register theirs only if it is free.
    match /emailIndex/{hash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Invites are created and accepted only through callable functions.
    match /invites/{code} {
      allow read, write: if false;
    }

    // A duel between two players. Created and moved between states by functions.
    // Clients list their own duels with: where('players', 'array-contains', uid)
    //
    // While the Cloud Functions are not deployed, the two players run the duel themselves under these rules:
    //  - create: a player challenges one of their FRIENDS; the duel starts 'pending' with the settings checked here;
    //  - accept / decline: only the invited player, only from 'pending'. Accepting sets the start from the server clock (the end is start + hours);
    //  - cancel: the challenger, only while still pending;
    //  - finish: either player, only after the end time;
    //  - counts: each player writes their own (see below). Coins are NOT moved by this: wallets stay server-only.
    match /duels/{duelId} {
      allow get: if signedIn() && request.auth.uid in resource.data.players;
      allow list: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['players', 'challengerUid', 'opponentUid', 'challengerName', 'opponentName',
                                                 'status', 'reelLimit', 'hours', 'stakeCoins', 'createdAt'])
        && request.resource.data.challengerUid == request.auth.uid
        && request.resource.data.opponentUid is string
        && request.resource.data.opponentUid != request.auth.uid
        && request.resource.data.players == [request.auth.uid, request.resource.data.opponentUid]
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.opponentUid))
        && request.resource.data.status == 'pending'
        && request.resource.data.reelLimit is int && request.resource.data.reelLimit >= 10 && request.resource.data.reelLimit <= 1000
        && request.resource.data.hours in [6, 24, 168]
        && request.resource.data.stakeCoins in [25, 50, 100]
        && request.resource.data.challengerName is string && request.resource.data.challengerName.size() >= 1 && request.resource.data.challengerName.size() <= 30
        && request.resource.data.opponentName is string && request.resource.data.opponentName.size() >= 1 && request.resource.data.opponentName.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid in resource.data.players && (
          // accept
          (resource.data.status == 'pending' && request.auth.uid == resource.data.opponentUid
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startAt'])
            && request.resource.data.startAt == request.time)
          // decline
          || (resource.data.status == 'pending' && request.auth.uid == resource.data.opponentUid
            && request.resource.data.status == 'declined'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          // cancel
          || (resource.data.status == 'pending' && request.auth.uid == resource.data.challengerUid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          // leave: either player may drop a battle that is running; it ends for both and has no result
          || (resource.data.status == 'active'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          // finish
          || (resource.data.status == 'active' && request.time >= resource.data.startAt + duration.value(resource.data.hours, 'h')
            && request.resource.data.status == 'finished'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );
      allow delete: if false;

      function duel() {
        return get(/databases/$(database)/documents/duels/$(duelId)).data;
      }

      function isPlayer() {
        return signedIn() && request.auth.uid in duel().players;
      }

      function isActive() {
        return duel().status == 'active';
      }

      // After the end the two final counts stay readable to the two players, so both see the same result.
      function isFinished() {
        return duel().status == 'finished';
      }

      function validCount() {
        let d = request.resource.data;
        let apps = d.perApp;
        return d.keys().hasOnly(['uid', 'total', 'perApp', 'dateKey', 'updatedAt'])
          && d.uid == request.auth.uid
          && d.total is int && d.total >= 0 && d.total <= 5000
          && d.dateKey is string && d.dateKey.size() == 10
          && d.updatedAt == request.time
          && apps is map
          && apps.keys().hasOnly(['instagram', 'youtube', 'facebook', 'snapchat'])
          && apps.get('instagram', 0) is int && apps.get('youtube', 0) is int
          && apps.get('facebook', 0) is int && apps.get('snapchat', 0) is int
          && d.total == apps.get('instagram', 0) + apps.get('youtube', 0)
                      + apps.get('facebook', 0) + apps.get('snapchat', 0)
          // Within a day the count only goes up.
          && (request.method == 'create'
              || d.dateKey != resource.data.dateKey
              || d.total >= resource.data.total);
      }

      // Today's count for one player. Both players read it, but only while the duel is active.
      match /counts/{uid} {
        allow read: if isPlayer() && (isActive() || isFinished());
        allow create, update: if isSelf(uid) && isPlayer() && isActive() && request.time < duel().startAt + duration.value(duel().hours, 'h') && validCount();
        allow delete: if false;
      }
    }

    // Friend unlock requests. Created, answered and expired only by the requestUnlock / respondUnlock functions
    // (they enforce 3 per rolling 24 h and "only the chosen friend may answer"). Both people may read their own.
    match /unlockRequests/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }

    // Push tokens: the owner registers and removes their own devices. Nobody else can read them.
    // The app writes its token on every start, so a second write (an update) must be allowed too; the document holds a time only.
    match /users/{uid}/fcmTokens/{token} {
      allow read: if false;
      allow create, update: if isSelf(uid) && request.resource.data.keys().hasOnly(['createdAt']);
      allow delete: if isSelf(uid);
    }

    // What the SERVER knows about a person's Pro subscription. Written only by verifyPurchase / playNotifications
    // (admin SDK). A phone can read its own and can never write it, so a modified app cannot unlock Pro.
    match /entitlements/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Coin wallet. Coins are virtual (HARD RULE: never money, never sold, never cashed out) and no field here can hold
    // money. The balance is never a mutable counter a client could nudge by any amount: it is the SUM of these immutable,
    // uniquely-id'd ops (append-only ledger, same idea as the pure CoinLedger/appliedOps in domain/challenge). The app
    // reads `wallets/{uid}/ops` and adds them up to show a balance. While Cloud Functions are not deployed, duel stakes
    // are escrowed and paid out by the two players' own phones creating these ops under the rules below (mirrors
    // DuelSettlement.holdOps/payoutOps and CoinOp exactly) — same trust tier already accepted for duel reel counts: a
    // modified app could misreport its own count, but it cannot invent coins (every op is checked against the real duel
    // and the real counts, and every id can be created once only, so retries or both phones racing cannot pay twice).
    // Forfeits are not recognised here (see duelWinner): a forfeited duel settles as a tie (both stakes refunded).
    // Check-in, streaks and shop purchases stay app-local (CoinWallet) until a Cloud Function can write them for real.
    // Reel-milestone ops (kind 'reel_milestone', +1 or 2 coins per 10 valid reels, 1.5 on average) live in this same ledger under their own
    // id namespace — see the isReelMilestone() function below for exactly what is, and is not, enforced without a
    // server-side reel-count ledger.
    match /wallets/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      match /ops/{opId} {
        allow read: if isSelf(uid);
        allow update, delete: if false;

        function op() { return request.resource.data; }
        function amount(d) { return d.stakeCoins; }

        // HOLD: I escrow my own stake when a duel I'm in becomes active. Exactly the duel's stakeCoins, exactly once.
        function isHold() {
          let d = duel_(op().duelId);
          return isSelf(uid) && uid in d.players && d.status == 'active'
            && opId == op().duelId + ':hold:' + uid
            && op().kind == 'hold' && op().amount == amount(d);
        }

        // RELEASE: my own held stake comes back to me — either the duel tied (nobody owes anybody) or I won it and
        // this reclaims my own stake (the loser's stake reaches me through the transfer ops below, not this one).
        function isRelease() {
          let d = duel_(op().duelId);
          let winner = duelWinner(op().duelId);
          return isSelf(uid) && uid in d.players && d.status == 'finished'
            && opId == op().duelId + ':settle:release:' + uid
            && op().kind == 'release' && op().amount == amount(d)
            && (winner == null || winner == uid);
        }

        // TRANSFER DEBIT: the loser's held stake leaves their wallet. Written by the OTHER player (the winner), since
        // a wallet only ever receives writes from its own owner or, here, from the one person allowed to prove they
        // beat this uid in a finished duel. The winner's own matching credit is a separate op on their own wallet.
        function isTransferDebit() {
          let d = duel_(op().duelId);
          return signedIn() && uid in d.players && request.auth.uid in d.players && request.auth.uid != uid
            && d.status == 'finished' && duelWinner(op().duelId) == request.auth.uid
            && opId == op().duelId + ':settle:transfer'
            && op().kind == 'transfer_debit' && op().amount == amount(d);
        }

        // TRANSFER CREDIT: my own wallet receives the stake I won. Same id as the debit (one logical transfer,
        // materialised as a matching pair of docs, one per wallet), so the two can be reconciled if ever audited.
        function isTransferCredit() {
          let d = duel_(op().duelId);
          return isSelf(uid) && uid in d.players && d.status == 'finished' && duelWinner(op().duelId) == uid
            && opId == op().duelId + ':settle:transfer'
            && op().kind == 'transfer_credit' && op().amount == amount(d);
        }

        // REEL MILESTONE: +1 coin for every 10 valid reels ever counted (see domain/coins/ReelMilestoneRules), self-
        // reported like the rest of this ledger. A completely separate kind of op from duel ops: its own id
        // namespace (reel_milestone:{N}, never a duel id), so it can never collide with or alter a duel's escrow
        // or settlement. What these rules CAN enforce without a Cloud Function: each milestone can be created once
        // only (so the same milestone is never paid twice), only by its own owner, always 1 coin (2 on even milestones), and only
        // in ascending order — milestone N requires milestone N-1 to already exist, so nobody can skip straight to
        // an arbitrarily large number in one write. What they CANNOT enforce without a server-side reel-count
        // ledger: that the milestone claimed was genuinely earned by real reel counts — a modified app could, in
        // principle, script many individually-valid sequential claims it never actually reached. This is a real,
        // accepted limitation of running without Cloud Functions (reel counts are not uploaded anywhere outside an
        // active duel), not something this rule can close on its own; reel-milestone coins are therefore a
        // strictly WEAKER trust tier than duel coins, which are cross-checked against both players' counts. A
        // future Cloud Function with its own authoritative reel-count upload would be needed to close this gap.
        function isReelMilestone() {
          return isSelf(uid)
            && op().kind == 'reel_milestone'
            && op().milestone is int && op().milestone > 0
            // 10 reels pay 1.5 coins on average, in whole coins: 1 for odd milestones, 2 for even ones. 1 is accepted for every
            // milestone too, so a phone that still has the older version (always 1) keeps being paid.
            && (op().amount == 1 || (op().amount == 2 && op().milestone % 2 == 0))
            && opId == 'reel_milestone:' + string(op().milestone)
            && (op().milestone == 1
                || exists(/databases/$(database)/documents/wallets/$(uid)/ops/$('reel_milestone:' + string(op().milestone - 1))));
        }

        allow create: if op().amount is int && op().amount > 0 && op().at == request.time && (
            (op().keys().hasOnly(['kind', 'amount', 'duelId', 'at'])
              && op().duelId is string
              && (isHold() || isRelease() || isTransferDebit() || isTransferCredit()))
            || (op().keys().hasOnly(['kind', 'amount', 'milestone', 'at']) && isReelMilestone())
          );
      }
    }

    // purchaseTokens/{hash} holds Play purchase tokens for the server's own use: no client access at all
    // (falls through to the closed default below).

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
