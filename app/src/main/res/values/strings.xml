    <!-- App and counter service -->
    <string name="app_name">Doomscroll Duel</string>
    <string name="a11y_service_description">Reels, Shorts aur Spotlight ginne ke liye. Yeh sirf Instagram, YouTube, Facebook aur Snapchat ka naam aur scroll dekhta hai, aur gin-ti ek number ki tarah phone mein rakhta hai. Yeh kabhi nahi padhta ya bhejta ki tum kya dekh rahe ho: koi text, username, caption ya video nahi. Jab tumne limit, bedtime ya focus lagaya ho, tab yeh reels screen se Back ya Home dabake wapas bhej sakta hai. Yeh kuch tap ya type nahi kar sakta.</string>
    <string name="tracking_channel_name">Reel counter</string>
    <string name="tracking_channel_description">Chhota, shaant notification jo counter ko chalta rakhta hai.</string>
