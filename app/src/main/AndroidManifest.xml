<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service that keeps the reel counter alive (Android 14 needs the type-specific permission). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Broadcast voice rooms: the microphone is used only while the person is in a room, and a notification says so. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+: lets the quiet "counter is on" notification be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A small tick of the vibration motor for each letter the first-run pages type. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Restart the notification after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Firebase Analytics adds the advertising-ID permission by itself. The app has no ads and never reads that ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!--
        Contacts: asked only when the person taps "Contacts dikhao" on the Dost screen. The phone hashes each contact email
        and sends only the hashes, to find friends who already use the app. Names, numbers and addresses are never uploaded.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!--
        Deliberately NOT requested: REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (Google Play restricts it).
    -->

    <application
        android:name=".DuelApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_short"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoomscrollDuel"
        tools:targetApi="34">

        <!--
            Analytics and crash reports are OFF until the person says yes (UsageDataApplier switches them on).
            No advertising ID, no ad personalisation, no Android-ID collection.
        -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Invite links: doomscrollduel://invite/CODE and https://<site>/invite/CODE open the accept screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doomscrollduel" android:host="invite" />
            </intent-filter>
            <!-- Tapping an invite notification opens the Dost page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doomscrollduel" android:host="friends" />
            </intent-filter>
            <!-- A battle notification opens that battle. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doomscrollduel" android:host="duel" />
            </intent-filter>
            <!-- A "battle over" notification opens that battle's result. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doomscrollduel" android:host="result" />
            </intent-filter>
            <!-- A broadcast invitation opens the Broadcast page and joins that room. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doomscrollduel" android:host="broadcast" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="@string/invite_web_host" android:pathPrefix="/invite/" />
            </intent-filter>
        </activity>

        <!--
            The reel counter. Only the system can bind to it (BIND_ACCESSIBILITY_SERVICE).
            What it may see is limited in res/xml/reel_accessibility_service.xml.
        -->
        <service
            android:name=".tracking.service.ReelAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/reel_accessibility_service" />
        </service>

        <service
            android:name=".tracking.service.ReelCounterForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the on-device reel counter running and shows today's reel count in a quiet notification." />
        </service>

        <receiver
            android:name=".tracking.service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- The user changed the clock or the time zone: bedtime and focus windows move with local time. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Approve / Deny buttons on a friend's unlock-request notification. -->
        <receiver
            android:name=".blocking.unlock.UnlockActionReceiver"
            android:exported="false" />

        <!-- Push messages for friend unlock (request to the friend, answer to the person who asked). -->
        <service
            android:name=".data.broadcast.BroadcastService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".blocking.unlock.UnlockMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
